# Discord bot token (official bot application only). Never commit or log this.
DISCORD_TOKEN=

# Exact guild and trap text channel IDs (snowflakes).
GUILD_ID=
TRAP_CHANNEL_ID=

# Trap-channel Embed GIF URL (HTTP/HTTPS). Leave blank to use the original GIF.
STATUS_GIF_URL=

# Persistent local SQLite path. Must be local disk, not :memory: or a network share.
DATABASE_PATH=./data/jobs.sqlite

# One of: debug, info, warn, error, critical
LOG_LEVEL=info
