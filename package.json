{
  "name": "banbot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord trap-channel softban bot with durable recovery",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file=.env dist/index.js"
  },
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
